<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns="https://jakarta.ee/xml/ns/jakartaee"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="https://jakarta.ee/xml/ns/jakartaee
                             https://jakarta.ee/xml/ns/jakartaee/web-app_5_0.xsd"
         version="5.0">

  <!-- アプリケーション名 -->
  <display-name>LACS</display-name>

  <!-- コンテキストパラメータ -->
  <context-param>
    <param-name>debugFlg</param-name>
    <param-value>1</param-value>
  </context-param>

  <!-- リスナー -->
  <listener>
    <listener-class>jp.co.pro_app.lacs.common.wprl.WPRLHomeInitialization</listener-class>
  </listener>

  <!-- Servlet 定義例 -->
  <servlet>
    <servlet-name>NSPrintServlet</servlet-name>
    <servlet-class>jp.co.pro_app.lacs.affairs.nsprint.servlet.LACSNSPrintServlet</servlet-class>
  </servlet>

  <servlet>
    <servlet-name>LoginServlet</servlet-name>
    <servlet-class>jp.co.pro_app.lacs.affairs.login.servlet.LACSLoginServlet</servlet-class>
    <load-on-startup>1</load-on-startup>
  </servlet>

  <servlet>
    <servlet-name>PasswordServlet</servlet-name>
    <servlet-class>jp.co.pro_app.lacs.affairs.password.servlet.LACSPasswordServlet</servlet-class>
  </servlet>

  <servlet>
    <servlet-name>TopServlet</servlet-name>
    <servlet-class>jp.co.pro_app.lacs.affairs.top.servlet.LACSTopServlet</servlet-class>
  </servlet>

  <servlet>
    <servlet-name>ShiharaiServlet</servlet-name>
    <servlet-class>jp.co.pro_app.lacs.affairs.shiharai.servlet.LACSShiharaiServlet</servlet-class>
  </servlet>

  <servlet>
    <servlet-name>ShiwakeServlet</servlet-name>
    <servlet-class>jp.co.pro_app.lacs.affairs.shiwake.servlet.LACSShiwakeServlet</servlet-class>
  </servlet>

  <servlet>
    <servlet-name>KeiyakuServlet</servlet-name>
    <servlet-class>jp.co.pro_app.lacs.affairs.keiyaku.servlet.LACSKeiyakuServlet</servlet-class>
  </servlet>

  <servlet>
    <servlet-name>BukkenServlet</servlet-name>
    <servlet-class>jp.co.pro_app.lacs.affairs.bukken.servlet.LACSBukkenServlet</servlet-class>
  </servlet>

  <servlet>
    <servlet-name>ReportServlet</servlet-name>
    <servlet-class>jp.co.pro_app.lacs.affairs.report.servlet.LACSReportServlet</servlet-class>
  </servlet>

  <servlet>
    <servlet-name>MasterServlet</servlet-name>
    <servlet-class>jp.co.pro_app.lacs.affairs.master.servlet.LACSMasterServlet</servlet-class>
  </servlet>

  <servlet>
    <servlet-name>CompanyServlet</servlet-name>
    <servlet-class>jp.co.pro_app.lacs.affairs.company.servlet.LACSCompanyServlet</servlet-class>
  </servlet>

  <servlet>
    <servlet-name>CompanyUserServlet</servlet-name>
    <servlet-class>jp.co.pro_app.lacs.affairs.companyuser.servlet.LACSCompanyUserServlet</servlet-class>
  </servlet>

  <servlet>
    <servlet-name>UserServlet</servlet-name>
    <servlet-class>jp.co.pro_app.lacs.affairs.user.servlet.LACSUserServlet</servlet-class>
  </servlet>

  <servlet>
    <servlet-name>KariRisiServlet</servlet-name>
    <servlet-class>jp.co.pro_app.lacs.affairs.karirisi.servlet.LACSKariRisiServlet</servlet-class>
  </servlet>

  <servlet>
    <servlet-name>TantoServlet</servlet-name>
    <servlet-class>jp.co.pro_app.lacs.affairs.tanto.servlet.LACSTantoServlet</servlet-class>
  </servlet>

  <servlet>
    <servlet-name>CompanyListServlet</servlet-name>
    <servlet-class>jp.co.pro_app.lacs.affairs.companylist.servlet.LACSCompanyListServlet</servlet-class>
  </servlet>

  <servlet>
    <servlet-name>CompanyUserListServlet</servlet-name>
    <servlet-class>jp.co.pro_app.lacs.affairs.companyuserlist.servlet.LACSCompanyUserListServlet</servlet-class>
  </servlet>

  <servlet>
    <servlet-name>UserListServlet</servlet-name>
    <servlet-class>jp.co.pro_app.lacs.affairs.userlist.servlet.LACSUserListServlet</servlet-class>
  </servlet>

  <servlet>
    <servlet-name>TantoListServlet</servlet-name>
    <servlet-class>jp.co.pro_app.lacs.affairs.tantolist.servlet.LACSTantoListServlet</servlet-class>
  </servlet>

  <servlet>
    <servlet-name>KariRisiListServlet</servlet-name>
    <servlet-class>jp.co.pro_app.lacs.affairs.karirisilist.servlet.LACSKariRisiListServlet</servlet-class>
  </servlet>

  <servlet>
    <servlet-name>MonthReportServlet</servlet-name>
    <servlet-class>jp.co.pro_app.lacs.affairs.monthreport.servlet.LACSMReportServlet</servlet-class>
  </servlet>

  <servlet>
    <servlet-name>InfoServlet</servlet-name>
    <servlet-class>jp.co.pro_app.lacs.affairs.info.servlet.LACSInfoServlet</servlet-class>
  </servlet>

  <servlet>
    <servlet-name>InfoListServlet</servlet-name>
    <servlet-class>jp.co.pro_app.lacs.affairs.infolist.servlet.LACSInfoListServlet</servlet-class>
  </servlet>

  <servlet>
    <servlet-name>SyousaiServlet</servlet-name>
    <servlet-class>jp.co.pro_app.lacs.affairs.syousai.servlet.LACSSyousaiServlet</servlet-class>
  </servlet>

  <servlet>
    <servlet-name>UkebaraiServlet</servlet-name>
    <servlet-class>jp.co.pro_app.lacs.affairs.ukebarai.servlet.LACSUkebaraiServlet</servlet-class>
  </servlet>

  <servlet>
    <servlet-name>DSReportServlet</servlet-name>
    <servlet-class>jp.co.pro_app.lacs.affairs.dsreport.servlet.LACSDSReportServlet</servlet-class>
  </servlet>

  <servlet>
    <servlet-name>NSReportServlet</servlet-name>
    <servlet-class>jp.co.pro_app.lacs.affairs.nsreport.servlet.LACSNSReportServlet</servlet-class>
  </servlet>

  <servlet>
    <servlet-name>CompulsoryChangeServlet</servlet-name>
    <servlet-class>jp.co.pro_app.lacs.affairs.compulsorychange.servlet.LACSCompulsoryChangeServlet</servlet-class>
  </servlet>


  <servlet-mapping>
    <servlet-name>NSPrintServlet</servlet-name>
    <url-pattern>*.nsprint</url-pattern>
  </servlet-mapping>
  
  <servlet-mapping>
    <servlet-name>LoginServlet</servlet-name>
    <url-pattern>*.login</url-pattern>
  </servlet-mapping>
  
  <servlet-mapping>
    <servlet-name>PasswordServlet</servlet-name>
    <url-pattern>*.password</url-pattern>
  </servlet-mapping>
  
  <servlet-mapping>
    <servlet-name>TopServlet</servlet-name>
    <url-pattern>*.top</url-pattern>
  </servlet-mapping>
  
  <servlet-mapping>
    <servlet-name>ShiharaiServlet</servlet-name>
    <url-pattern>*.shiharai</url-pattern>
  </servlet-mapping>
  
  <servlet-mapping>
    <servlet-name>ShiwakeServlet</servlet-name>
    <url-pattern>*.shiwake</url-pattern>
  </servlet-mapping>
  
  <servlet-mapping>
    <servlet-name>KeiyakuServlet</servlet-name>
    <url-pattern>*.keiyaku</url-pattern>
  </servlet-mapping>
  
  <servlet-mapping>
    <servlet-name>BukkenServlet</servlet-name>
    <url-pattern>*.bukken</url-pattern>
  </servlet-mapping>
  
  <servlet-mapping>
    <servlet-name>ReportServlet</servlet-name>
    <url-pattern>*.report</url-pattern>
  </servlet-mapping>
  
  <servlet-mapping>
    <servlet-name>MasterServlet</servlet-name>
    <url-pattern>*.master</url-pattern>
  </servlet-mapping>
  
  <servlet-mapping>
    <servlet-name>CompanyServlet</servlet-name>
    <url-pattern>*.company</url-pattern>
  </servlet-mapping>
  
  <servlet-mapping>
    <servlet-name>CompanyUserServlet</servlet-name>
    <url-pattern>*.companyuser</url-pattern>
  </servlet-mapping>
  
  <servlet-mapping>
    <servlet-name>UserServlet</servlet-name>
    <url-pattern>*.user</url-pattern>
  </servlet-mapping>
  
  <servlet-mapping>
    <servlet-name>KariRisiServlet</servlet-name>
    <url-pattern>*.karirisi</url-pattern>
  </servlet-mapping>
  
  <servlet-mapping>
    <servlet-name>TantoServlet</servlet-name>
    <url-pattern>*.tanto</url-pattern>
  </servlet-mapping>
  
  <servlet-mapping>
    <servlet-name>CompanyListServlet</servlet-name>
    <url-pattern>*.companylist</url-pattern>
  </servlet-mapping>
  
  <servlet-mapping>
    <servlet-name>CompanyUserListServlet</servlet-name>
    <url-pattern>*.companyuserlist</url-pattern>
  </servlet-mapping>
  
  <servlet-mapping>
    <servlet-name>UserListServlet</servlet-name>
    <url-pattern>*.userlist</url-pattern>
  </servlet-mapping>
  
  <servlet-mapping>
    <servlet-name>KariRisiListServlet</servlet-name>
    <url-pattern>*.karirisilist</url-pattern>
  </servlet-mapping>
  
  <servlet-mapping>
    <servlet-name>TantoListServlet</servlet-name>
    <url-pattern>*.tantolist</url-pattern>
  </servlet-mapping>
  
  <servlet-mapping>
    <servlet-name>MonthReportServlet</servlet-name>
    <url-pattern>*.monthreport</url-pattern>
  </servlet-mapping>
  
  <servlet-mapping>
    <servlet-name>InfoServlet</servlet-name>
    <url-pattern>*.info</url-pattern>
  </servlet-mapping>
  
  <servlet-mapping>
    <servlet-name>InfoListServlet</servlet-name>
    <url-pattern>*.infolist</url-pattern>
  </servlet-mapping>
  
  <servlet-mapping>
    <servlet-name>SyousaiServlet</servlet-name>
    <url-pattern>*.syousai</url-pattern>
  </servlet-mapping>
  
  <servlet-mapping>
    <servlet-name>UkebaraiServlet</servlet-name>
    <url-pattern>*.ukebarai</url-pattern>
  </servlet-mapping>
  
  <servlet-mapping>
    <servlet-name>DSReportServlet</servlet-name>
    <url-pattern>*.dsreport</url-pattern>
  </servlet-mapping>
  
  <servlet-mapping>
    <servlet-name>NSReportServlet</servlet-name>
    <url-pattern>*.nsreport</url-pattern>
  </servlet-mapping>
  
  <servlet-mapping>
    <servlet-name>CompulsoryChangeServlet</servlet-name>
    <url-pattern>*.compulsorychange</url-pattern>
  </servlet-mapping>

  <!-- セッション設定 -->
  <session-config>
    <session-timeout>-1</session-timeout>
  </session-config>

  <!-- ウェルカムファイル -->
  <welcome-file-list>
    <welcome-file>/notfound.html</welcome-file>
  </welcome-file-list>

  <!-- エラーページ -->
  <error-page>
    <error-code>404</error-code>
    <location>/notfound.html</location>
  </error-page>

  <!-- リソース参照 -->
  <resource-ref>
    <description>ORADB DataSource</description>
    <res-ref-name>jdbc/ORADB</res-ref-name>
    <res-type>jakarta.sql.DataSource</res-type>
    <res-auth>Container</res-auth>
  </resource-ref>

</web-app>
